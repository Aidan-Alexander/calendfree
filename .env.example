# Copy to .env for local testing with `npm run dev`. On Netlify, set these under
# Site configuration → Environment variables (or run `npm run setup`).

# From Google Cloud (see the README). Not needed when OVERLAP_FAKE_GOOGLE=1.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Any long random string. Keep it the same forever: changing it signs everyone out and
# drops saved calendar connections. Make one with: openssl rand -hex 32
APP_SECRET=

# Who may sign in and make booking pages. Either list people, or allow a whole domain.
ADMIN_EMAILS=you@example.org
# ALLOWED_DOMAINS=example.org

# Optional: serve the app under a path, e.g. /meet → https://your-site/meet/...
# BASE_PATH=/meet

# Optional: the address people use, if it isn't the Netlify site's own (for example when another
# site proxies /meet to this one). Comma-separate several. Include the base path.
# PUBLIC_URL=https://example.com/meet

# Local testing only: made-up calendars, and "Sign in" skips Google.
OVERLAP_FAKE_GOOGLE=1
